{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryotcc",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./app",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}